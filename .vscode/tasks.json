{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "next-dev",
            "type": "shell",
            "command": "npm.cmd",
            "args": [
                "run",
                "dev",
                "--",
                "--port",
                "3000"
            ],
            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                    "regexp": "^(.*)$",
                    "message": 1
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": "^> next dev",
                    "endsPattern": "Ready in"
                }
            },
            "presentation": {
                "reveal": "always",
                "panel": "dedicated"
            }
        }
    ]
}
